# Flask Configuration
FLASK_SECRET_KEY=dev-secret-shopping-agent-key-2025
FLASK_ENV=development
DEBUG=True

# AI / LLM Configuration
# Options for LLM_PROVIDER: gemini, openai, none (fallback to local deterministic analysis)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Database Configuration
DATABASE_URL=sqlite:///shopping.db

# Scraping & Demo Mode
# When True, reliable curated demonstration data is served when live sites throttle or block
USE_SAMPLE_DATA=true

# Request Timeout (seconds)
REQUEST_TIMEOUT=6
